# Application
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/newsflow?schema=public


# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Cloudflare R2 (S3 Compatible)
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=newsflow-files
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# Email (Resend/SendGrid/SES)
EMAIL_FROM=noreply@newsflow.app
EMAIL_PROVIDER=resend
EMAIL_API_KEY=your-email-api-key

# WhatsApp (Twilio/Meta)
WHATSAPP_PROVIDER=twilio
WHATSAPP_ACCOUNT_SID=your-account-sid
WHATSAPP_AUTH_TOKEN=your-auth-token
WHATSAPP_FROM_NUMBER=+1234567890

# VAPID Keys (Web Push Notifications)
# Generate at https://vapidkeys.com or use `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=mailto:admin@newsflow.app

# Payment Gateway (Razorpay/Stripe)
PAYMENT_PROVIDER=razorpay
PAYMENT_KEY_ID=your-key-id
PAYMENT_KEY_SECRET=your-key-secret
PAYMENT_WEBHOOK_SECRET=your-webhook-secret

# App URLs
ADMIN_DASHBOARD_URL=http://localhost:3001
MOBILE_APP_URL=http://localhost:3002
API_URL=http://localhost:3000

# CORS (comma-separated, e.g. http://localhost:3002,http://localhost:3003,https://nams-admin.vercel.app)
ALLOWED_ORIGINS=
# CSP connect-src extras (comma-separated, for IPs like http://192.168.1.35:3000)
CSP_CONNECT_SRC=

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json