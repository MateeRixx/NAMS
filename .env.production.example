# =======================================
# NewsFlow Production Environment Variables
# Copy to .env on EC2 and fill secrets
# =======================================

# Application
NODE_ENV=production
PORT=3000
API_PREFIX=/api/v1

# Database (uses Docker service name 'postgres')
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@postgres:5432/newsflow

# Redis (uses Docker service name 'redis')
REDIS_URL=redis://redis:6379

# JWT — generate a strong random key: openssl rand -hex 64
JWT_SECRET=change-this-to-a-random-64-char-hex-string
JWT_EXPIRES_IN=7d

# Cloudflare R2 (S3 Compatible)
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=newsflow-files
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# Email (Resend)
EMAIL_FROM=noreply@newsflow.app
EMAIL_PROVIDER=resend
EMAIL_API_KEY=your-resend-api-key

# WhatsApp (Twilio — optional)
WHATSAPP_PROVIDER=none
WHATSAPP_ACCOUNT_SID=
WHATSAPP_AUTH_TOKEN=
WHATSAPP_FROM_NUMBER=

# VAPID Keys for Web Push
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=mailto:admin@newsflow.app

# Payment Gateway (Razorpay)
PAYMENT_PROVIDER=razorpay
PAYMENT_KEY_ID=rzp_live_xxxxxxxxxxxx
PAYMENT_KEY_SECRET=your-key-secret
PAYMENT_WEBHOOK_SECRET=your-webhook-secret

# App URLs — frontends on Vercel
ADMIN_DASHBOARD_URL=https://nams-admin.vercel.app
MOBILE_APP_URL=https://nams-customer.vercel.app
API_URL=http://YOUR_EC2_PUBLIC_IP:80

# CORS — comma-separated origins allowed (optional if ADMIN/MOBILE_URL cover it)
ALLOWED_ORIGINS=

# CSP connect-src extras — IPs for dev (leave empty in production)
CSP_CONNECT_SRC=

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
